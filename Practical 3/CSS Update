*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}
body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    color: #333;
    padding: 20px;
    background:
        linear-gradient(135deg, rgba(37, 99, 235, 0.55), rgba(99, 102, 241, 0.55), rgba(139, 92, 246, 0.55)),
        url("../images/studenthub.jpg")  center center / cover no-repeat fixed;
        background-size: 70% auto;
}
h1{
    text-align:center;
     color: linear-gradient(135deg, #1E3A8A, #4338CA, #6D28D9);
    background:linear-gradient(90deg,#1E3A8A,#4338CA,#7C3AED);
    padding:20px;
    border-radius:10px;
    margin-bottom:20px;
}

h2,h3,h4,h5{
    text-align:center;
      color: linear-gradient(135deg, #1E3A8A, #4338CA, #6D28D9);
    margin:20px;
}

nav{
   background: linear-gradient(90deg,#1E3A8A,#4338CA,#7C3AED);
    padding:12px;
    text-align:center;
    border-radius:8px;
    margin-bottom:20px;
}

nav a{
    color:white;
    margin: 15px;
    font-weight:bold;
}

nav a:hover{
    color:#FFD700;
}
.box{
  background:linear-gradient(135deg,#4F46E5,#6366F1,#8B5CF6);
    padding:20px;
    border-radius:10px;
    margin-bottom:20px;
}
.box:hover{
     background: linear-gradient(135deg,#8B5CF6,#2563EB);
}
form{
    width:100%;
    max-width:750px;
    margin:30px auto;
    padding:30px;
    background:rgba(255,255,255,.95);
    border-radius:20px;
}
form label{
    display:inline-block;
    width:170px;
    text-align:right;
    margin-right:15px;
    font-size:18px;
    vertical-align:middle;
}
form input[type="text"],
form input[type="email"],
form input[type="password"],
form input[type="date"],
form input[type="number"],
form select,
form textarea{
    width:350px;
    padding:12px 15px;
    border:1px solid #ccc;
    border-radius:25px;
    font-size:16px;
    margin-bottom:18px;
}

form textarea{
    height:120px;
    resize:vertical;
}

/* Focus Effect means When We clik on that button like curser */
form input:focus,
form select:focus,
form textarea:focus{
    outline:none;
    border-color:#4a69bd;
}

/*  Only For Gender Section */
.gender{
    text-align:center;
    margin:20px ;
}

.gender-title{
    display:block;
    font-size:22px;
    font-weight:bold;
    margin-bottom:15px;
    color:#333;
}

.gender label{
    width:auto;
    text-align:left;
    margin-right:25px;
    font-size:18px;
}

.gender input[type="radio"]{
    width:18px;
    height:18px;
    accent-color:#4a69bd;
    margin-right:5px;
    cursor:pointer;
}
form input[type="submit"],
form input[type="reset"]{
    width:170px;
    padding:12px;
    border:none;
    border-radius:30px;
    font-size:18px;
    cursor:pointer;
    margin:15px 10px ;
}

form input[type="submit"]{
    background: linear-gradient(90deg,#1E3A8A,#4338CA,#7C3AED);
    color:white;
}

form input[type="submit"]:hover{
    background: linear-gradient(135deg,#8B5CF6,#2563EB);
}

form input[type="reset"]{
     background: linear-gradient(135deg,#8B5CF6,#2563EB);
    color:white;
}

form input[type="reset"]:hover{
    background: linear-gradient(90deg,#1E3A8A,#4338CA,#7C3AED);
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
    border-radius:12px;
    overflow:hidden;
}

th{
    background:linear-gradient(135deg,#1E3A8A,#4338CA,#7C3AED);
    color:white;
    padding:14px;
    font-size:18px;
}

td{
     background:linear-gradient(135deg,#4F46E5,#6366F1,#8B5CF6);
    color:#ffffff;
    padding:12px;
    text-align:center;
}

table,th,td{
    border:1px solid rgba(255,255,255,0.4);
}

tr:hover td{
    background:linear-gradient(135deg,#3B82F6,#6366F1,#8B5CF6);
}
img{
    width:250px;
    display:block;
    margin:20px auto;
    border-radius:50px;
}
button{
   background: linear-gradient(135deg,#2563EB,#4F46E5,#8B5CF6);
    padding:10px;
    margin:10px;
    color:white;
    font-size: 18px;
    font-weight:bold;
    border:none;
     border-radius:30px;
}
button:hover{
   background: linear-gradient(135deg,#8B5CF6,#2563EB);

    }
button:focus{
    outline:none;
}

.dashboard-notice {
    background: rgba(255, 255, 255, 0.9);
    border-left: 5px solid #2563eb;
    border-radius: 10px;
    padding: 12px 16px;
    margin: 15px 0 20px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.dashboard-notice p {
    margin: 0;
    color: #333;
    font-size: 16px;
    line-height: 1.5;
}



footer{
   background:linear-gradient(90deg,#1E3A8A,#4338CA,#7C3AED);
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
    border-radius:8px;
}
@media(max-width:700px) {

    .container {
        width: 95%;
        padding: 20px;
    }

    .header {
        width: 95%;
    }

    .footer {
        width: 95%;
    }

    .logo {
        width: 160px;
        height: 160px;
    }

    .navbar {
        flex-direction: column;
    }

    .nav-btn {
        width: 100%;
        text-align: center;
    }

    .page-title {
        font-size: 24px;
    }

    .header h1 {
        font-size: 24px;
    }

}
