* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    color: #F8FAFC;
    padding: 20px;
    background: /*linear-gradient( 135deg, rgba(2, 6, 23, 0.70),  rgba(30, 27, 75, 0.60),   rgba(49, 46, 129, 0.50) ),*/
        url("../images/background.jpg") center center / cover no-repeat fixed;
}
h1 {
    text-align: center;
   background: linear-gradient(90deg,#0F172A,#312E81,#4C1D95,#1E3A8A ); 
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 20px;
}
h2 {
    text-align: center;
    color: #A78BFA;
    margin: 20px;
}
h3 {
    text-align: center;
    color: #67E8F9;
    margin: 20px;
}
h4 {
    text-align: center;
    color: #C4B5FD;
    margin: 20px;
}
h5 {
    text-align: center;
    color: #93C5FD;
    margin: 20px;
}
/*----------Navigation Styling----------------*/
nav {
    background: linear-gradient(   90deg,   #0F172A,   #312E81,   #4C1D95,   #1E3A8A ); 
    padding: 12px;
    text-align: center;
    border-radius: 8px;
    margin-bottom: 20px;
}
nav a {
    color: #adcaec;
    margin: 15px;
    font-weight: bold;
    text-decoration: none;
}
nav a:hover {
    color: #f1e670;
}
/*----------Box Styling----------------*/
.box {
    background: linear-gradient(  135deg,  rgba(15, 23, 42, 0.92),  rgba(49, 46, 129, 0.88),  rgba(76, 29, 149, 0.85) );
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 20px;
    border: 1px solid rgba(103, 232, 249, 0.25);
}
.box:hover {
    background: linear-gradient( 135deg,rgba(49, 46, 129, 0.95),rgba(76, 29, 149, 0.92), rgba(37, 99, 235, 0.90));
}
/*----------Form Styling----------------*/
form {
    width: 100%;
    max-width: 750px;
    margin: 30px auto;
    padding: 30px;
    background: rgba(248, 250, 252, 0.95);
    border-radius: 20px;
}
form label {
    display: inline-block;
    width: 170px;
    text-align: right;
    margin-right: 15px;
    font-size: 18px;
    vertical-align: middle;
    color: #1E1B4B;
    font-weight: bold;
}
form input[type="text"],
form input[type="email"],
form input[type="password"],
form input[type="date"],
form input[type="number"],
form select,
form textarea {
    width: 350px;
    padding: 12px 15px;
    border: 2px solid #4b62c8;
    border-radius: 25px;
    font-size: 16px;
    margin-bottom: 18px;
    background: #FFFFFF;
    color: #1E1B4B;
    border-color:linear-gradient( 135deg, #7C3AED, #2563EB, #06B6D4);

}
form textarea {
    height: 120px;
    resize: vertical;
}
form input:focus,
form select:focus,
form textarea:focus {
    outline: none;
    border-color: linear-gradient( 135deg,rgba(49, 46, 129, 0.95),rgba(76, 29, 149, 0.92), rgba(37, 99, 235, 0.90));
}
/*----------gender Section-------*/
.gender {
    text-align: center;
    margin: 20px;
}

.gender-title {
    display: block;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 15px;
    color: #1E1B4B;
}

.gender label {
    width: auto;
    text-align: left;
    margin-right: 25px;
    font-size: 18px;
}
.gender input[type="radio"] {
    width: 18px;
    height: 18px;
    margin-right: 5px;
    cursor: pointer;
}
form input[type="submit"],
form input[type="reset"] {
    width: 170px;
    padding: 12px;
    border: none;
    border-radius: 30px;
    font-size: 18px;
    cursor: pointer;
    color: #FFFFFF;
    font-weight: bold;
}
form input[type="submit"] {
    background: linear-gradient(135deg,  #4C1D95,#2563EB,#06B6D4);
}
form input[type="submit"]:hover {
    background: linear-gradient(135deg, #7C3AED, #2563EB, #06B6D4);
}
form input[type="reset"] {
    background: linear-gradient( 135deg, #312E81, #7C3AED);
}
form input[type="reset"]:hover {
    background: linear-gradient(135deg, #7C3AED, #4C1D95, #2563EB);
}
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    border-radius: 12px;
    overflow: hidden;
}
th {
    background: linear-gradient( 135deg, #0F172A,#312E81, #4C1D95 );
    color: #67E8F9;
    padding: 14px;
    font-size: 18px;
}
td {
    background: linear-gradient( 135deg, #1E1B4B, #312E81, #3730A3);
    color: #F8FAFC;
    padding: 12px;
    text-align: center;
}
table,
th,
td {
    border: 1px solid rgba(103, 232, 249, 0.30);
}
tr:hover td {
    background: linear-gradient( 135deg, #312E81, #4C1D95, #2563EB );
    color: #FFFFFF;
}
/*-----Image Part----*/
img {
    width: 250px;
    display: block;
    margin: 20px auto;
    border-radius: 50px;
    border: 2px solid #7f6fdb;
}
/*-----Button Styling-------*/
button {
    background: linear-gradient(  135deg,  #4C1D95,  #2563EB,  #06B6D4);
    padding: 10px 20px;
    margin: 10px;
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    border: none;
    border-radius: 30px;
    cursor: pointer;
}
button:hover {
    background: linear-gradient( 135deg, #7C3AED, #2563EB, #06B6D4);
}
button:focus {
    outline: none;
}
/*------------------------Dashboard Notice Styling--------------------*/
.dashboard-notice {
    background: rgba(248, 250, 252, 0.95);
    border-left: 5px solid #7C3AED;
    border-radius: 10px;
    padding: 12px 16px;
    margin: 15px 0 20px;
}
.dashboard-notice p {
  margin: 0;
  color: #1E1B4B;
  font-size: 16px;
}
/* ------------------------Footer Styling--------------------*/
footer {
    background: linear-gradient(90deg, #0F172A, #312E81, #4C1D95,  #1E3A8A  );
    color: #F8FAFC;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
    border-radius: 8px;
}
footer:hover{
      background: linear-gradient( 135deg, #7C3AED, #2563EB, #06B6D4);
}
/*------------------------Responsive Design--------------------*/
@media (max-width: 700px) {
    .container {
        width: 95%;
        padding: 20px;
    }
    .header {
        width: 95%;
    }
    .footer {
        width: 95%;
    }
    .logo {
        width: 160px;
        height: 160px;
    }
    .navbar {
        flex-direction: column;
    }

    .nav-btn {
        width: 100%;
        text-align: center;
    }

    .page-title {
        font-size: 24px;
    }

    .header h1 {
        font-size: 24px;
    }

    /* Make form fit mobile screen */
    form {
        padding: 20px;
    }

    form label {
        width: 100%;
        text-align: left;
        margin-bottom: 5px;
    }

    form input[type="text"],
    form input[type="email"],
    form input[type="password"],
    form input[type="date"],
    form input[type="number"],
    form select,
    form textarea {
        width: 100%;
    }

    form input[type="submit"],
    form input[type="reset"] {
        width: 45%;
    }
    nav a {
        display: inline-block;
        margin: 8px;
    }
}
